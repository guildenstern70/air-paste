{
  "tasks": {
    "start": "deno run --env --allow-net --allow-env --allow-read=. --allow-write=. src/main.ts",
    "dev": "deno run --watch --env --allow-net --allow-env --allow-read=. --allow-write=. src/main.ts",
    "test": "deno test --env --allow-net --allow-env --allow-read=. --allow-write=. src/main_test.ts",
    "lint": "deno lint src",
    "fmt": "deno fmt src"
  },
  "compilerOptions": {
    "checkJs": true,
    "strict": true
  },
  "version": "0.1.2",
  "imports": {
    "@std/assert": "jsr:@std/assert@1",
    "@std/path": "jsr:@std/path@1",
    "@eta-dev/eta": "jsr:@eta-dev/eta@3",
    "@littlelite/dyelog": "jsr:@littlelite/dyelog@^0.2.1",
    "@upstash/redis": "npm:@upstash/redis@^1.38.0"
  }
}
